# ==============================================================================
# RAKSHA-NER BACKEND PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / External MongoDB)
# ------------------------------------------------------------------------------
# PRODUCTION: Required. Point to your MongoDB Atlas cluster or managed instance.
# DEVELOPMENT: Optional. If omitted, embedded MongoMemoryServer launches automatically.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/raksha-ner?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong, cryptographically random secret string for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key_in_production

# ------------------------------------------------------------------------------
# 4. CROSS-ORIGIN RESOURCE SHARING (CORS) & WEBSOCKET ORIGINS
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins for Express API and Socket.IO
# In development, you can use '*' or leave blank to permit localhost.
# In production, set to your exact frontend domain(s).
CORS_ALLOWED_ORIGIN=https://raksha-ner.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. MACHINE LEARNING RISK PREDICTION MICROSERVICE
# ------------------------------------------------------------------------------
# URL of the deployed FastAPI / Python ML landslide risk prediction service
ML_SERVICE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 6. EXTERNAL GEOSPATIAL & METEOROLOGICAL TELEMETRY
# ------------------------------------------------------------------------------
# (All external APIs gracefully fallback to calibrated regional baselines if omitted)

# OpenWeatherMap API (Live rainfall intensity & ambient weather)
# Get key: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# data.gov.in IMD API (India Meteorological Department regional rainfall)
# Get key: https://data.gov.in/
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here

# Copernicus Data Space / Sentinel Hub API (Sentinel-2 NDVI & Surface Scarp Analysis)
# Get credentials: https://dataspace.copernicus.eu/
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret_here

# OpenTopography Global SRTM 30m Digital Elevation Model API
# Get key: https://opentopography.org/
OPENTOPOGRAPHY_API_KEY=your_opentopography_api_key_here

# ------------------------------------------------------------------------------
# 7. TELECOM GATEWAY (VONAGE SMS & VOICE CALL EARLY WARNINGS)
# ------------------------------------------------------------------------------
# Live SMS and Voice calls to offline citizens and SDMA quick-response teams.
# If omitted or left empty, simulated gateway mode is used automatically.
# Get credentials: https://dashboard.nexmo.com/
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_PHONE_NUMBER=your_registered_vonage_number
DEMO_RECIPIENT_PHONE=+919876543230

# ------------------------------------------------------------------------------
# 8. WEB PUSH BROWSER EMERGENCY NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Used for desktop/mobile browser push notifications.
# Generate pairs via: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_EMAIL=mailto:eoc-alerts@raksha-ner.gov.in
