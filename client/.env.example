# RAKSHA-NER Frontend Client Environment Configuration

# ==============================================================================
# 1. API GATEWAY URL
# ==============================================================================
# Development (default): Leave blank or use '/api' (proxied by Vite to http://localhost:5000)
# Production: Set to your deployed backend URL (e.g., https://raksha-api.onrender.com or https://api.raksha.gov.in)
VITE_API_URL=/api

# ==============================================================================
# 2. REAL-TIME SOCKET.IO URL (Optional)
# ==============================================================================
# If Socket.IO runs on the same server as VITE_API_URL, leave this blank (auto-detected).
# Only specify if your WebSocket server is hosted on a separate dedicated hostname/port.
# VITE_SOCKET_URL=https://raksha-socket.onrender.com
